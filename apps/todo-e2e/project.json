{
  "name": "todo-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/todo-e2e/src",
  "projectType": "application",
  "targets": {
    "e2e": {
      "executor": "@nx/cypress:cypress",
      "options": {
        "cypressConfig": "apps/todo-e2e/cypress.config.ts",
        "devServerTarget": "todo:serve:development",
        "testingType": "e2e",
        "webServerCommands": {
          "default": "nx run todo-be:serve"
        }
      },
      "configurations": {
        "production": {
          "devServerTarget": "todo:serve:production"
        }
      }
    },
    "e2e-ci": {
      "executor": "@nx/cypress:cypress",
      "options": {
        "cypressConfig": "apps/todo-e2e/cypress.config.ts",
        "testingType": "e2e",
        "baseUrl": "http://localhost:4200",
        "spec": "apps/todo-e2e/src/e2e/authenticated-smoke.cy.ts,apps/todo-e2e/src/e2e/auth-session.cy.ts,apps/todo-e2e/src/e2e/inbox-quick-capture.cy.ts,apps/todo-e2e/src/e2e/settings-preferences.cy.ts,apps/todo-e2e/src/e2e/onboarding-tour.cy.ts,apps/todo-e2e/src/e2e/statistics-reports.cy.ts"
      }
    },
    "e2e-agent": {
      "executor": "@nx/cypress:cypress",
      "options": {
        "cypressConfig": "apps/todo-e2e/cypress.config.ts",
        "testingType": "e2e",
        "baseUrl": "http://localhost:4200",
        "spec": "apps/todo-e2e/src/e2e/agent-chat.cy.ts,apps/todo-e2e/src/e2e/inbox-quick-capture-enrichment.cy.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  },
  "tags": [],
  "implicitDependencies": ["todo"]
}
