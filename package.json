{
  "name": "todolist",
  "description": "Full-stack task manager with React and NestJS, built on Nx",
  "version": "0.1.1",
  "engines": {
    "npm": ">=9.3.1",
    "node": "24.x"
  },
  "scripts": {
    "docker:mongodb": "docker-compose -f tools/mongodb/docker-compose.yml up",
    "serve:fe": "nx serve todo",
    "serve:be": "nx serve todo-be",
    "build": "nx build",
    "test:unit:fe": "nx test todo",
    "test:unit:be": "nx test todo-be",
    "test:unit": "nx run-many --target=test",
    "test:e2e": "nx e2e todo-e2e --spec=apps/todo-e2e/src/e2e/authenticated-smoke.cy.ts",
    "test:e2e:watch": "nx e2e todo-e2e --watch",
    "lint": "nx run-many --target=lint",
    "check:deprecated-tokens": "node scripts/check-deprecated-tokens.js",
    "seed:demo": "node scripts/seed-demo.js",
    "typecheck": "tsc --build apps/todo apps/todo-be libs/types",
    "eval:agent": "ts-node -r tsconfig-paths/register --project apps/todo-be/tsconfig.app.json apps/todo-be/src/agent/evals/run-eval.ts",
    "emulator": "firebase emulators:start",
    "all": "npm run docker:mongodb & npm run emulator & npm run serve:be & npm run serve:fe"
  },
  "private": true,
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@hookform/resolvers": "^5.9.1",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/testing": "^10.4.20",
    "@nestjs/throttler": "^6.5.0",
    "@sentry/nestjs": "^10.74.0",
    "@tanstack/react-query": "^5.102.8",
    "@types/nodemailer": "^7.0.11",
    "axios": "^1.20.0",
    "core-js": "3.50.0",
    "dayjs": "^1.11.23",
    "express": "4.18.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.3.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.45.0",
    "mongodb": "^5.9.2",
    "mongoose": "7.6.8",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^8.0.2",
    "pino-http": "^11.0.0",
    "react": "^18.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "regenerator-runtime": "0.14.1",
    "rxjs": "^7.8.2",
    "tslib": "2.8.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "7.18.6",
    "@nrwl/webpack": "17.2.8",
    "@nx/cypress": "17.2.8",
    "@nx/eslint": "17.2.8",
    "@nx/eslint-plugin": "17.2.8",
    "@nx/express": "17.2.8",
    "@nx/jest": "17.2.8",
    "@nx/js": "17.2.8",
    "@nx/node": "17.2.8",
    "@nx/react": "23.2.1",
    "@nx/web": "17.2.8",
    "@nx/workspace": "17.2.8",
    "@pmmmwh/react-refresh-webpack-plugin": "0.6.3",
    "@svgr/webpack": "8.1.0",
